<component type="desktop-application">
  <id>io.github.mahziyarng98.cawget</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Cawget</name>
  <summary>Fast segmented download manager</summary>
  <developer id="io.github.mahziyarng98">
    <name>mahziyarng98</name>
  </developer>
  <description>
    <p>
      Cawget downloads files over HTTP and HTTPS using several connections at once, and resumes
      interrupted downloads where they stopped, also after a crash.
    </p>
    <ul>
      <li>Parallel segments with automatic rebalancing of slow connections</li>
      <li>Persistent queue with scheduling, retries, a speed limit and SHA-256 verification</li>
      <li>Categories by file type, each with its own download folder</li>
      <li>Adapts to any window size, from small tiles to 4K; light and dark themes; right-to-left layout</li>
    </ul>
  </description>
  <launchable type="desktop-id">Cawget.desktop</launchable>
  <url type="homepage">https://github.com/mahziyarng98/cawget</url>
